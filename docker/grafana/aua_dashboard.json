{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "AUA Framework — Adaptive Utility Agents observability dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Query Volume & Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(aua_queries_total[5m])",
          "legendFormat": "{{domain}} / {{routing_mode}}",
          "refId": "A"
        }
      ],
      "title": "Query Rate (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(aua_query_latency_seconds_bucket[5m]))",
          "legendFormat": "p50 {{domain}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(aua_query_latency_seconds_bucket[5m]))",
          "legendFormat": "p95 {{domain}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(aua_query_latency_seconds_bucket[5m]))",
          "legendFormat": "p99 {{domain}}",
          "refId": "C"
        }
      ],
      "title": "Query Latency p50/p95/p99",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "max": 1, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 0.4 }, { "color": "green", "value": 0.7 }] } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto" },
      "targets": [
        {
          "expr": "aua_utility_score",
          "legendFormat": "{{domain}}",
          "refId": "A"
        }
      ],
      "title": "Utility Score by Domain",
      "type": "gauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Routing & Quality",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 10 },
      "id": 4,
      "targets": [
        {
          "expr": "rate(aua_routing_field_distribution[5m])",
          "legendFormat": "{{field}}",
          "refId": "A"
        }
      ],
      "title": "Routing Distribution",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 10 },
      "id": 5,
      "targets": [
        {
          "expr": "aua_contradiction_rate",
          "legendFormat": "{{domain}}",
          "refId": "A"
        }
      ],
      "title": "Contradiction Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 10 },
      "id": 6,
      "targets": [
        {
          "expr": "rate(aua_arbiter_verdict_distribution[5m])",
          "legendFormat": "{{case}}",
          "refId": "A"
        }
      ],
      "title": "Arbiter Verdicts",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 102,
      "title": "Specialist Health & VRAM",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "max": 1, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 0.8 }] } },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 18 },
      "id": 7,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "aua_specialist_confidence",
          "legendFormat": "{{specialist}}",
          "refId": "A"
        }
      ],
      "title": "Specialist Confidence",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 0.8 }, { "color": "red", "value": 0.95 }] } },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 18 },
      "id": 8,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "aua_specialist_vram_utilization",
          "legendFormat": "{{specialist}}",
          "refId": "A"
        }
      ],
      "title": "VRAM Utilization",
      "type": "gauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 103,
      "title": "Corrections & Learning",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 26 },
      "id": 9,
      "targets": [
        {
          "expr": "rate(aua_correction_count[10m])",
          "legendFormat": "{{domain}}",
          "refId": "A"
        }
      ],
      "title": "Corrections Stored (rate)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "fixedColor": "blue", "mode": "fixed" } }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 26 },
      "id": 10,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "aua_dpo_pairs_accumulated",
          "legendFormat": "DPO pairs",
          "refId": "A"
        }
      ],
      "title": "DPO Pairs Accumulated",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "id": 104,
      "title": "Auth & Security",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 34 },
      "id": 11,
      "targets": [
        {
          "expr": "rate(aua_token_requests_total[5m])",
          "legendFormat": "{{scope}} / {{status}}",
          "refId": "A"
        }
      ],
      "title": "Token Requests by Scope & Status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 34 },
      "id": 12,
      "targets": [
        {
          "expr": "rate(aua_hook_failures_total[5m])",
          "legendFormat": "{{hook_point}}",
          "refId": "A"
        }
      ],
      "title": "Hook Failures",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "id": 105,
      "title": "Cost",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 42 },
      "id": 13,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "aua_cost_usd_total",
          "legendFormat": "{{specialist}}",
          "refId": "A"
        }
      ],
      "title": "Total Cost (USD)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "h" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 42 },
      "id": 14,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "expr": "aua_cost_gpu_hours_total",
          "legendFormat": "{{specialist}}",
          "refId": "A"
        }
      ],
      "title": "GPU Hours by Specialist",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["aua", "adaptive-utility-agents", "llm"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "AUA Framework",
  "uid": "aua-framework-v1",
  "version": 1
}
