# AUA Framework — environment variables
# Copy to .env and fill in your values. Never commit .env to git.

# ── Versions ──────────────────────────────────────────────────────────────────
AUA_VERSION=0.7.0b0
OLLAMA_VERSION=latest
VLLM_VERSION=latest
PROMETHEUS_VERSION=latest
GRAFANA_VERSION=latest

# ── Router ────────────────────────────────────────────────────────────────────
AUA_ROUTER_PORT=8000
AUA_TIER=macbook       # macbook | single-4090 | quad-4090 | a100-cluster

# ── Models (override defaults from tier config) ───────────────────────────────
SWE_MODEL=qwen2.5-coder:7b
MATH_MODEL=qwen2.5:7b
ARBITER_MODEL=qwen2.5:3b

# ── Observability ─────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=aua-admin     # change this in production!
